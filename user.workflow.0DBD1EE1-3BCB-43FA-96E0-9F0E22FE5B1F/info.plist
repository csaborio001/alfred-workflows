				<string>#!/bin/zsh

set -euo pipefail

SOURCE="$1"
SOURCE="${SOURCE%/}"

PARENT="$(dirname "$SOURCE")"
NAME="$(basename "$SOURCE")"

INFRA="$SOURCE/infrastructure.php"

VERSION=""
if [[ -f "$INFRA" ]]; then
  VERSION=$(
    /usr/bin/awk -F': *' '
      /^[[:space:]]*\*?[[:space:]]*Version:/ {
        gsub(/\r/, "", $2)
        print $2
        exit
      }
    ' "$INFRA"
  )
fi

if [[ -n "$VERSION" ]]; then
  OUTFILE="$PARENT/${NAME}-${VERSION}.zip"
else
  OUTFILE="$PARENT/${NAME}.zip"
fi

TMP_EXCLUDES="$(/usr/bin/mktemp)"

cleanup() {
  /bin/rm -f "$TMP_EXCLUDES"
}
trap cleanup EXIT

cat &gt; "$TMP_EXCLUDES" &lt;&lt;'EOF'
*/node_modules/*
*/.git/*
*/tests/*
*/process/*
*/package-lock.json
*/gulpfile.js
*.yml
*/vendor/fzaninotto/*
*/.gitignore
*/scorpiotek-testing-plugin/*
*/config/*
*.testing
*/composer.json
*/composer.lock
*/package.json
*/local-dev-tools.php
*/local-overrides.php
*/test-results/*
*/tests_output/*
*/logs/*
EOF

(
  cd "$PARENT"
  /bin/rm -f "$OUTFILE"
  /usr/bin/zip -rq "$OUTFILE" "$NAME" -x@"$TMP_EXCLUDES"
)

echo "$OUTFILE"</string>
