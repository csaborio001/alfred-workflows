				<string>#!/bin/zsh

BW_SESSION=519t43XX0FtJsSac6RibPBFbEQ2a9RrsL9c2/p+aOHkpArphY4t+pVhYsdoRiKL2yfLVqRfUtt12PMJ0bewjMg==

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

SECRET="$(pbpaste)"

if [[ -z "$SECRET" ]]; then
  echo "Clipboard is empty"
  exit 1
fi

# Unlock Bitwarden via macOS password dialog
BW_PASS=$(osascript -e 'display dialog "Bitwarden master password:" default answer "" with hidden answer buttons {"Cancel","OK"} default button "OK"' -e 'text returned of result') || exit 1

export BW_PASSWORD="$BW_PASS"
export BW_SESSION="$(bw unlock --passwordenv BW_PASSWORD --raw 2&gt;/dev/null)"
unset BW_PASSWORD
unset BW_PASS

if [[ -z "$BW_SESSION" ]]; then
  echo "Failed to unlock Bitwarden"
  exit 1
fi

NAME="Clipboard secret $(date '+%Y-%m-%d %H:%M')"

LINK=$(bw send template send.text \
  | jq --arg name "$NAME" --arg text "$SECRET" '
      .name=$name
      | .text.text=$text
      | .deletionDate = (now + 86400 | todateiso8601)
    ' \
  | bw encode \
  | bw send create \
  | jq -r '.accessUrl')

if [[ -n "$LINK" &amp;&amp; "$LINK" != "null" ]]; then
  echo -n "$LINK" | pbcopy
  echo "Bitwarden Send link copied"
else
  echo "Failed to create Bitwarden Send"
  exit 1
fi</string>
