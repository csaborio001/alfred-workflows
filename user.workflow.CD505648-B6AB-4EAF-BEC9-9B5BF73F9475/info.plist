				<string>MARKITDOWN="/Users/csaborio/tools/pdf2md/.venv/bin/markitdown"

SUCCESS=0
FAILED=0

for PDF in "$@"; do
    OUT="${PDF%.*}.md"

    "$MARKITDOWN" "$PDF" -o "$OUT"

    if [ -f "$OUT" ]; then
        SUCCESS=$((SUCCESS + 1))
    else
        FAILED=$((FAILED + 1))
    fi
done

osascript -e "display notification \"$SUCCESS converted, $FAILED failed\" with title \"PDF → Markdown\""</string>
