				<string>#!/bin/bash

set -u

domain="${1:-}"
domain="${domain#http://}"
domain="${domain#https://}"
domain="${domain%%/*}"
domain="${domain## }"
domain="${domain%% }"
domain="${domain%.}"

if [[ -z "$domain" ]]; then
	echo "Enter a domain after NS."
	exit 0
fi

if [[ ! "$domain" =~ ^[A-Za-z0-9.-]+$ ]]; then
	echo "Invalid domain: $domain"
	exit 0
fi

printf '%s\n' "DNS overview: $domain" ""

show_records() {
	local label="$1"
	local record_type="$2"
	local result

	result="$(/usr/bin/dig +time=2 +tries=1 +short "$domain" "$record_type" 2>/dev/null)"
	printf '%s\n' "$label"
	if [[ -n "$result" ]]; then
		printf '%s\n' "$result" | sed 's/^/  /'
	else
		printf '%s\n' "  (none found)"
	fi
	printf '\n'
}

show_records "A (IPv4)" A
show_records "AAAA (IPv6)" AAAA
show_records "CNAME (alias)" CNAME
show_records "NS (nameservers)" NS
show_records "MX (mail servers)" MX
show_records "TXT (verification and policy)" TXT
show_records "CAA (certificate authorities)" CAA
show_records "SOA (zone authority)" SOA</string>
