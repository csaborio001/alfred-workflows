				<string>import sys
import secrets
import string
import os

# The mode ("mem" or "complex") is passed from Alfred
mode = sys.argv[1]

def generate_memorable():
    """Generates a 4-word password from the built-in macOS dictionary."""
    try:
        # Use the built-in macOS dictionary file
        dict_path = '/usr/share/dict/words'
        if not os.path.exists(dict_path):
            return "Error: Dictionary file not found."

        with open(dict_path) as f:
            words = [word.strip() for word in f]
        
        # Filter for reasonably-sized words
        word_pool = [w for w in words if 4 &lt;= len(w) &lt;= 8 and w.isalpha()]
        
        # Select 4 cryptographically random words
        password_parts = [secrets.choice(word_pool) for _ in range(4)]
        print("-".join(password_parts), end="")

    except Exception as e:
        print(f"Error: {e}", end="")


def generate_complex():
    """Generates a 12-character complex password."""
    # Define the character sets
    letters = string.ascii_letters
    digits = string.digits
    special_chars = '$&amp;*'
    
    alphabet = letters + digits + special_chars
    
    while True:
        password = ''.join(secrets.choice(alphabet) for _ in range(12))
        # Ensure the password contains at least one of each required type
        if (any(c in letters for c in password) and
            any(c in digits for c in password) and
            any(c in special_chars for c in password)):
            print(password, end="")
            break

# --- Main Logic ---
if mode == "mem":
    generate_memorable()
elif mode == "complex":
    generate_complex()
else:
    print("Invalid mode. Use 'mem' or 'complex'.", end="")</string>
