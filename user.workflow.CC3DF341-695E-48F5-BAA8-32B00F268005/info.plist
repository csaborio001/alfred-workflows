				<key>script</key>
				<string>#!/bin/bash

set -e

TMP_DIR="${TMPDIR:-/tmp}"
STAMP=$(date +"%Y-%m-%d_%H-%M-%S")
FILENAME="clipboard-${STAMP}.png"
LOCAL_FILE="${TMP_DIR}${FILENAME}"
REMOTE_DIR="RaycastUploads"
REMOTE_PATH="${REMOTE_DIR}/${FILENAME}"

# Save clipboard image to a PNG file
osascript -e '
set theImage to the clipboard as «class PNGf»
set outFile to POSIX file "'"$LOCAL_FILE"'"
try
	set fileRef to open for access outFile with write permission
	set eof fileRef to 0
	write theImage to fileRef
	close access fileRef
on error errMsg number errNum
	try
		close access outFile
	end try
	error errMsg number errNum
end try
'

if [ ! -f "$LOCAL_FILE" ]; then
  echo "No image found on clipboard"
  exit 1
fi

# Upload to OneDrive
rclone copy "$LOCAL_FILE" "onedrive:${REMOTE_DIR}"

# Create public link
LINK=$(rclone link "onedrive:${REMOTE_PATH}")

# Copy link to clipboard
printf "%s" "$LINK" | pbcopy

# Return link for Alfred output
echo "$LINK"</string>
