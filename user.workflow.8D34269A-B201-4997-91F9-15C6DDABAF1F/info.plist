				<key>script</key>
				<string>#!/bin/bash

# Loop through all the files passed by Alfred ("$@")
for f in "$@"; do
  # It's better to match against just the filename, not the full path
  filename=$(basename "$f")

  # Check if the filename contains the date pattern
  if [[ "$filename" =~ \[[0-9]{2}-[0-9]{2}-[0-9]{4}\] ]]; then
    # Run your external script, passing the full path to the file
    ~/scripts/set_file_date.sh "$f"
  fi
done</string>
